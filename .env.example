# Copy to .env and fill in. Never commit .env.

# Long random string; the phone app asks for it once. Generate: openssl rand -hex 24
APP_TOKEN=change-me

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ntfy: inside docker the app reaches ntfy at http://ntfy; pick an unguessable topic
NTFY_URL=http://ntfy
NTFY_TOPIC=jarvis-change-me-to-something-random
# Address your phone uses to open the app when you tap a notification (your Tailscale name)
APP_PUBLIC_URL=http://your-server.tailnet-name.ts.net:8000
NTFY_PUBLIC_URL=http://your-server.tailnet-name.ts.net:8080

# ELMS announcements arrive as Canvas notification emails; Jarvis reads them (read-only) over IMAP.
# Use the inbox those emails land in, plus a Google app password (myaccount.google.com/apppasswords).
IMAP_HOST=imap.gmail.com
# One or more inboxes, comma-separated: email:app-password
# (non-Gmail: email:password@imap.server.com)
# e.g. IMAP_ACCOUNTS=you@gmail.com:abcdabcdabcdabcd,second@gmail.com:efghefghefghefgh
IMAP_ACCOUNTS=
# ELMS deadlines come from the ELMS calendar you've subscribed to in Google Calendar.
# Course codes you care most about (matched in event titles and email subjects)
PRIORITY_COURSES=CMSC424,MATH401,CMSC335

# Job feed: raw URL of the listings JSON in the new-grad repo you follow (see README)
JOBS_FEED_URL=
JOB_KEYWORDS=software,engineer,developer,swe,backend,full stack,full-stack

# Google Calendar OAuth client file (see README); token is created by scripts/google_auth.py
GOOGLE_CLIENT_FILE=data/google_client.json
GOOGLE_TOKEN_FILE=data/google_token.json
